# Only VITE_-prefixed variables are exposed to the browser by Vite.

# Network the wallet and vault reads use: devnet | testnet | mainnet
VITE_SUI_NETWORK=testnet

# Network for DeepBook price data (DeepBook v3 exists on testnet and mainnet only).
# Defaults to VITE_SUI_NETWORK when it is testnet or mainnet.
VITE_DEEPBOOK_NETWORK=testnet

# Published tge_dca package id. Get it from: sui client publish --gas-budget 100000000
VITE_PACKAGE_ID=0x0
